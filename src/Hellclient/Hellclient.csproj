<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- <PublishTrimmed>true</PublishTrimmed> -->
    <!-- <PublishAot>true</PublishAot> -->
    <!-- <TrimMode>full</TrimMode> -->
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>true</SelfContained>
    <OptimizationPreference>Size</OptimizationPreference>
    <DebugType Condition="'$(Configuration)' != 'Debug'">none</DebugType>
    <DebugSymbols Condition="'$(Configuration)' != 'Debug'">false</DebugSymbols>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>

  </PropertyGroup>
  <!-- 兼容 Hellclient的表现-->
  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug|AnyCPU'">
    <OutputPath>..\..\debug</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <AppendRuntimeIdentifierToOutputPath>false</AppendRuntimeIdentifierToOutputPath>
  </PropertyGroup>
  <ItemGroup>
    <TrimmerRootAssembly Include="System.Security.Cryptography" />
    <ProjectReference Include="..\Hellclient.Core\Hellclient.Core.csproj" />
    <ProjectReference Include="..\Hellclient.World\Hellclient.World.csproj" />
    <ProjectReference Include="..\Hellclient.V8Engine\Hellclient.V8Engine.csproj" />
  </ItemGroup>
</Project>