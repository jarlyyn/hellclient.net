<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <PublishTrimmed>true</PublishTrimmed>
    <TrimMode>full</TrimMode>
    <OptimizationPreference>Size</OptimizationPreference>
    <DebugType Condition="'$(Configuration)' != 'Debug'">none</DebugType>
    <DebugSymbols Condition="'$(Configuration)' != 'Debug'">false</DebugSymbols>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Tomlyn" Version="2.10.1" />
    <PackageReference Include="Microlithix.AnsiParser" Version="1.0.0" />
  </ItemGroup>
</Project>