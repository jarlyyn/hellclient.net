<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <PublishTrimmed>true</PublishTrimmed>
    <TrimMode>full</TrimMode>
    <OptimizationPreference>Size</OptimizationPreference>
    <DebugType Condition="'$(Configuration)' != 'Debug'">none</DebugType>
    <DebugSymbols Condition="'$(Configuration)' != 'Debug'">false</DebugSymbols>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\Hellclient.World\Hellclient.World.csproj" />
    <ProjectReference Include="..\Hellclient.Script\Hellclient.Script.csproj" />    
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="pythonnet" Version="3.1.0" />
  </ItemGroup>

</Project>